; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pin Down"
run/main_scene="res://scenes/ui/splash.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameEvents="*res://scripts/game_events.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
GameSettings="*res://scripts/systems/game_settings.gd"
Worlds="*res://scripts/systems/worlds.gd"
Profile="*res://scripts/systems/profile.gd"
BallSkins="*res://scripts/systems/ball_skins.gd"
Achievements="*res://scripts/systems/achievements.gd"
Challenges="*res://scripts/systems/challenges.gd"
MusicManager="*res://scripts/systems/music_manager.gd"
SceneRouter="*res://scripts/systems/scene_router.gd"
UITheme="*res://scripts/systems/ui_theme.gd"
Notifier="*res://scripts/systems/notifier.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=720
window/size/window_width_override=800
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[input]

flipper={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
, Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}
restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":114,"location":0,"echo":false,"script":null)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="ball"
2d_physics/layer_3="hazard"
2d_physics/layer_4="exit"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
2d/default_gravity=1100.0

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.14, 1)
